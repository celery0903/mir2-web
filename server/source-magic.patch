+  this.direction=pixelDirection(from,to);this.oldDirection=this.direction;this.lastStep=startedAt;this.lastFrame=startedAt;
+ }
+ private aim(from:Point,to:Point){
+  const dx=to.x-from.x,dy=to.y-from.y,axis=Math.max(Math.abs(dx),Math.abs(dy),1);
+  return {x:legacyRound(dx*500/axis),y:legacyRound(dy*500/axis)};
+ }
+ advance(now:number,target:Point|undefined,count:number){
+  if(this.hit||this.expired)return;
+  if(now<this.lastStep)return;
+  if(now-this.lastFrame>this.interval){this.frame=(this.frame+1)%count;this.lastFrame=now;}
+  if(target&&!this.ground){
