+ reject(){this.reply='failed';}
+ advance(now:number){
+  if(this.finished)return;
+  if(this.reply==='pending'&&now-this.startedAt>this.timeout)this.reply='failed';
+  if(now-this.lastStep<=this.interval)return;
+  if(this.frame===this.visual.count-2&&this.reply==='pending')return;
+  this.frame++;this.lastStep=now;
+ }
+ bodyFrame(count:number){return this.frame>=this.visual.count-1?count-1:Math.min(count-2,this.frame);}
+}
+
+// Port of the traditional TMagicEff.Shift and TBujaukGroundEffect.Run branches.
+export class ProjectileFlight {
+ readonly direction:number;readonly from:Point;point:Point;target:Point;frame=0;hit=false;expired=false;
+ private floating:Point;private velocity:Point;private previous={x:99999,y:99999};private oldDirection:number;
+ private lastStep:number;private lastFrame:number;
