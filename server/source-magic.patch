+    const difference=desired[axis]-this.velocity[axis];
+    if(difference)this.velocity[axis]+=Math.sign(difference)*Math.max(1,Math.trunc(Math.abs(difference)/10));
+    this.floating[axis]+=this.velocity[axis]/700*(now-this.lastStep);
