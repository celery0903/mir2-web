+import rules from '../../../content/classic-176/magic-effects.json';
+
+export type Sequence={library:string;start:number;count:number;interval:number};
+export type Projectile=Sequence&{stride:number;impact:Sequence};
+type Plan={kind:'projectile';sequence:Projectile}|{kind:'sequence';sequence:Sequence}|{kind:'beam';sequence:Sequence&{stride:number}};
+
+export function castSequence(effect:number):Sequence|undefined{
+ if(!Number.isInteger(effect)||effect<1||effect>rules.readyBases.length)return;
+ const override=(rules.readyOverrides as Record<string,{count:number;interval:number}>)[effect];
+ return {library:rules.magic2ReadyEffects.includes(effect)?'Magic2':'Magic',start:rules.readyBases[effect-1],count:override?.count??rules.readyCount,interval:override?.interval??rules.readyInterval};
+}
+
+export function effectPlan(effectType:number,effect:number):Plan|undefined{
+ const projectile=(rules.projectiles as Record<number,Projectile>)[effect];
+ if(projectile&&((effectType===1&&(effect===1||effect===3))||(effectType===8&&(effect===10||effect===17))||(effectType===9&&(effect===11||effect===12))))return {kind:'projectile',sequence:projectile};
+ const impact=(rules.impactSequences as Record<number,Sequence>)[effect];
+ if(effectType===2&&impact)return {kind:'sequence',sequence:impact};
+ if(effectType===7&&effect===9)return {kind:'sequence',sequence:rules.thunder};
+ if(effectType===6&&effect===8)return {kind:'beam',sequence:rules.beam};
+}
+
+export function spellPose<T extends {x:number;y:number;direction:number}>(caster:T,target:{x:number;y:number}){
+ const dx=target.x-caster.x,dy=target.y-caster.y;
+ let direction=caster.direction;
+ if(dx||dy){
+  if(dx===0)direction=dy<0?0:4;
+  else if(dy===0)direction=dx<0?6:2;
+  else if(Math.abs(dy)>Math.abs(dx)*2.5)direction=dy<0?0:4;
+  else if(Math.abs(dy)<Math.abs(dx)/3)direction=dx<0?6:2;
+  else direction=dx>0?(dy<0?1:3):(dy<0?7:5);
+ }
+ return {...caster,direction,action:'spell' as const};
+}
+
+export function projectileDirection(from:{x:number;y:number},to:{x:number;y:number}){
+ return pixelDirection({x:from.x*48,y:from.y*32},{x:to.x*48,y:to.y*32});
+}
+
+type Point={x:number;y:number};
+function pixelDirection(from:Point,to:Point){
+ const dx=to.x-from.x,dy=to.y-from.y;
+ if(dx===0)return dy<0?0:8;
+ if(dy===0)return dx<0?12:4;
+ const ratio=Math.abs(dy/dx),sector=ratio>4?4:ratio>1.4?3:ratio>1/1.9?2:ratio>1/4?1:0;
+ return dx>0?(dy<0?4-sector:4+sector):(dy<0?(12+sector)%16:12-sector);
+}
+
+export function legacyRound(value:number){
+ const low=Math.floor(value),fraction=value-low;
+ return fraction===.5?(low%2===0?low:low+1):Math.round(value);
