+    public static object? GroupModeAtLogon(LegacyPacket packet)
+    {
+        if (packet.Id != 50) return null;
+        byte[] body = packet.Body;
+        if (body.Length < 16) return null;
+        // MessageBodyWL.Tag1 low byte carries the native saved AllowGroup flag.
+        return new { type = "groupMode", enabled = body[8] == 1 };
+    }
+
     public static uint? Feature(LegacyPacket packet)
     {
         if (packet.Id == 41) return (uint)packet.Param | (uint)packet.Tag << 16;
