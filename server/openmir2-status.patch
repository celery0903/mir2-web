+                }
+            }
+            if (changed)
+            {
+                CharStatus = GetCharStatus();
+                StatusChanged();
+            }
+            if (recalculate)
+            {
+                RecalcAbilitys();
+                SendMsg(Messages.RM_ABILITY, 0, 0, 0, 0);
+            }
+            if (!Death && unchecked(now - PoisoningTick) > SystemShare.Config.PosionDecHealthTime)
