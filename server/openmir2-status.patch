+        protected void ProcessStatus(int now)
+        {
+            bool changed = false, recalculate = false;
+            for (int i = 0; i < StatusArrTick.Length; i++)
+            {
+                if (StatusTimeArr[i] == 0 || StatusTimeArr[i] >= 60000 || unchecked(now - StatusArrTick[i]) <= 1000)
+                {
+                    continue;
+                }
+                StatusTimeArr[i]--;
+                StatusArrTick[i] = unchecked(StatusArrTick[i] + 1000);
+                if (StatusTimeArr[i] == 0)
+                {
+                    changed = true;
+                    switch (i)
+                    {
+                        case PoisonState.DefenceUP:
+                            recalculate = true;
+                            SysMsg("防御力回复正常.", MsgColor.Green, MsgType.Hint);
