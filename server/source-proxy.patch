+    private sealed record DialoguePart(string text, string? command = null, bool input = false);
+
+    private static DialoguePart[][] DialogueLines(string content)
+    {
+        content = CleanQuest(content, out _, out _).Replace('\\', '\n');
+        return content.Split('\n').Select(line =>
+        {
+            var parts = new List<DialoguePart>();
+            int cursor = 0;
+            foreach (Match link in Link().Matches(line))
+            {
+                if (link.Index > cursor)
+                    parts.Add(new(Decoration().Replace(line[cursor..link.Index], match => match.Groups[1].Value)));
+                string command = link.Groups[2].Value;
+                parts.Add(new(link.Groups[1].Value, command, command.StartsWith("@@InPutString", StringComparison.OrdinalIgnoreCase)));
+                cursor = link.Index + link.Length;
+            }
+            if (cursor < line.Length)
+                parts.Add(new(Decoration().Replace(line[cursor..], match => match.Groups[1].Value)));
+            return parts.ToArray();
+        }).ToArray();
     }

